# Copy to server/.env and fill in. server/.env is gitignored.

# Port for the Express API (bound to 127.0.0.1 only).
PORT=4000
LOG_LEVEL=info

# REQUIRED: bearer token every /api/birthdays request must present.
# The server refuses to start if this is missing or shorter than 16 chars.
#   openssl rand -hex 32
API_TOKEN=CHANGE_ME_generate_a_64_hex_char_token

# Exact browser origins allowed by CORS (comma-separated). The Vite dev client
# runs on 5173 by default. No wildcard.
CORS_ORIGINS=http://localhost:5173

# --- Database: connect as the LEAST-PRIVILEGE app role, not the superuser. ---
# Option A: a single connection string (takes precedence over PG* vars).
# DATABASE_URL=postgresql://bm_app:password@localhost:5544/thebirthdates
#
# Option B: individual settings. PGPASSWORD is REQUIRED (no default fallback).
PGHOST=localhost
PGPORT=5544
PGUSER=bm_app
PGPASSWORD=CHANGE_ME_match_APP_DB_PASSWORD_in_root_.env
PGDATABASE=thebirthdates

# Set to "true" when connecting to a Postgres that requires TLS (verifies cert).
PGSSL=false
