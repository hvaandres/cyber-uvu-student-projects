# Copy to client/.env (gitignored). Vite exposes VITE_* vars to the browser.

# API base URL. Empty = same origin (Vite dev proxy / production reverse proxy).
VITE_API_URL=http://localhost:4000

# Bearer token sent with each API request. Must equal server API_TOKEN.
# See SECURITY.md: a browser-visible token gates anonymous access only.
VITE_API_TOKEN=CHANGE_ME_match_server_API_TOKEN
