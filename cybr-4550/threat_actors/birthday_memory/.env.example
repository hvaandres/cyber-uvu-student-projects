# Copy to .env and set STRONG, UNIQUE values before `docker compose up`.
# .env is gitignored. NEVER commit a real .env to this public repo.
#
# Generate strong secrets, e.g.:
#   openssl rand -base64 24     # for passwords
#   openssl rand -hex 32        # for the API token

# --- Bootstrap superuser (used only by the DB container's init) ---
POSTGRES_DB=thebirthdates
POSTGRES_USER=bm_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_admin_password

# --- Least-privilege application role (what the API actually connects as) ---
APP_DB_USER=bm_app
APP_DB_PASSWORD=CHANGE_ME_strong_app_password
